DISCORD_BOT_TOKEN=

# ── Identity ──────────────────────────────────────────────────────────────
# BOT_NAME=Heckler            # what people call the bot; also its wake word ("Hey Heckler, leave")
# WAKE_WORDS=hackler,heckle   # extra names / spellings that also wake it (comma-separated, 5+ letters)
# BOT_VOICE_FILE=my voice.mp3 # ~10 s of clear speech to clone the bot's voice from (optional)
# BOT_VOICE_DESCRIPTION=male, young adult, moderate pitch
#                             # used when there's no BOT_VOICE_FILE: gender, age, pitch, whisper, accent
#                             # (see omnivoice/utils/voice_design.py for the allowed words)
# DEFAULT_LANGUAGE=en         # language for servers that haven't picked one (/language): en, es

# ── Dashboard ─────────────────────────────────────────────────────────────
# DASHBOARD=1                 # admin web dashboard
# DASHBOARD_HOST=127.0.0.1    # 0.0.0.0 = reachable from your network (token still required)
# DASHBOARD_PORT=8765
# DASHBOARD_TOKEN=            # empty = generated once and saved in data/dashboard_token

# ── Speech ────────────────────────────────────────────────────────────────
# VOICE=1                     # the bot talks (OmniVoice, ~2.3 GB VRAM); 0 = listen only
# WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# WHISPER_LANGUAGES=en,es     # languages Whisper may expect; each server's own language is used first
# STT_ENGINE=whisper          # whisper (GPU, most accurate), hybrid (Parakeet + Whisper re-check), parakeet (CPU only)
# PARAKEET_DEVICE=cpu         # hybrid/parakeet only: gpu = ~3x faster Parakeet, +3.4 GB GPU
# END_SILENCE_S=0.6           # pause that ends a sentence; lower = faster replies, more split sentences
# AUTO_JOIN=1                 # join calls with 2+ people by itself, leave when empty (/autojoin to toggle live)
# (gag cooldowns, chances, quotas, transcripts and language are per-server settings in the dashboard)

# ── Debugging (only for people who accepted transcripts) ─────────────────
# POST_TRANSCRIPTS=0          # 1 = also post "**user**: text" in the channel where !join was used
# SAVE_AUDIO=0                # 1 = also keep each sentence as a .wav in recordings/
